# Plantilla de variables (el codigo NO lee .env: exportelas en el shell). Todas son OPCIONALES.
# MongoDB (defecto: localhost). MONGO_STRICT=1 falla en vez de usar el fallback JSON.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cds_energia
MONGO_STRICT=0
# IA generativa. Orden automatico: ANTHROPIC_API_KEY > GEMINI_API_KEY > OLLAMA_MODEL > Bedrock > plantilla offline.
# SIG_LLM=anthropic|gemini|ollama|bedrock|offline fuerza un proveedor. Si el LLM falla -> plantilla (modo offline) con aviso.
SIG_LLM=
# Opcion GRATIS 1: Google Gemini API, nivel gratuito (clave sin tarjeta en https://aistudio.google.com/apikey).
# GOOGLE_API_KEY tambien se acepta. Sin GEMINI_MODEL se descubre uno flash-lite/flash via GET /models.
GEMINI_API_KEY=
GEMINI_MODEL=
# Opcion GRATIS 2: Ollama local (sin clave). Solo se activa si OLLAMA_MODEL esta definido. Antes: ollama pull llama3.2:3b
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
# Opcion de pago: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Alternativa Amazon Bedrock: requiere BEDROCK_MODEL_ID y credenciales AWS
BEDROCK_MODEL_ID=
# Publicacion S3: requiere S3_BUCKET y credenciales AWS (cadena estandar de boto3)
S3_BUCKET=
S3_PREFIX=cds-energia-sig
AWS_REGION=us-east-1
# Fuente de datos: sintetico (defecto; el flujo regenera data/raw) o real (NO genera: solo valida el esquema de data/raw)
SIG_FUENTE=sintetico
